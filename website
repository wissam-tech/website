<style>
:root{--bg:#090909;--panel:#171717;--gold:#d8ad55;--light:#f1d28b;--text:#f5f1e8;--muted:#b4ada1;--line:rgba(216,173,85,.25)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;background:var(--bg);color:var(--text);font-family:Tahoma,Arial,sans-serif;line-height:1.9}
a{color:inherit;text-decoration:none}.container{width:min(1050px,90%);margin:auto}
header{position:sticky;top:0;z-index:5;background:#090909f2;border-bottom:1px solid var(--line)}
.nav{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:18px}
.logo{font-weight:900;font-size:1.3rem;direction:ltr}.logo span,h1 span,.section-title span{color:var(--gold)}
nav{display:flex;gap:16px;flex-wrap:wrap}nav a{color:var(--muted);font-size:.9rem}nav a:hover{color:var(--light)}
.hero{text-align:center;padding:95px 0;background:radial-gradient(ellipse at top,rgba(216,173,85,.18),transparent 55%)}
.eyebrow{border:1px solid var(--line);border-radius:30px;padding:5px 15px;color:var(--light)}
h1{font-size:clamp(2.5rem,7vw,4.5rem);line-height:1.3;margin:20px 0 8px}
.hero p{max-width:680px;margin:0 auto 24px;color:var(--muted)}
.btn{display:inline-block;background:var(--gold);color:#17130b;padding:9px 20px;border-radius:8px;font-weight:bold;transition:.2s}
.btn:hover{background:var(--light)}
.btn-outline{display:inline-block;background:transparent;color:var(--gold);border:1px solid var(--gold);padding:8px 19px;border-radius:8px;font-weight:bold;transition:.2s}
.btn-outline:hover{background:rgba(216,173,85,.12);color:var(--light)}
.btn-group{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
section{padding:65px 0}.section-title{text-align:center;margin-bottom:30px}.section-title h2{font-size:2rem;margin:0}
.section-title p{color:var(--muted);margin:4px 0}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card,.topic,.about-box{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px}
.card:hover{border-color:var(--gold);transform:translateY(-4px);transition:.2s}
.icon{font-size:2rem}.card h3,.topic h3{color:var(--light);margin:5px 0}
.card p,.topic p,.topic li,.about-box p{color:var(--muted)}
.card p{margin:0 0 14px}.topic{max-width:900px;margin:auto;padding:30px}
.topic-section{border-top:1px solid var(--line)}.topic h3{font-size:1.4rem}
.topic h4{color:var(--gold);margin:18px 0 4px}.topic ul{padding-right:22px}
.topic li{padding:2px 0}.note{border-right:3px solid var(--gold);background:#d8ad5510;padding:10px 14px;margin-top:18px;border-radius:6px}
.about{background:#10100e;border-block:1px solid var(--line)}.about-box{max-width:800px;margin:auto;text-align:center}
.contact{text-align:center}.contact p{color:var(--muted)}
footer{text-align:center;padding:20px;border-top:1px solid var(--line);color:var(--muted)}footer span{color:var(--gold)}
@media(max-width:750px){.nav{flex-direction:column;padding:12px 0}nav{justify-content:center;gap:12px}.cards{grid-template-columns:1fr}.hero{padding:75px 0}.topic{padding:20px}}
</style>
